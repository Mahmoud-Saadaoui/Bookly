PORT=5001
NODE_ENV=development

MONGO_URI=mongodb://localhost:27017/bookly

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=30d
BCRYPT_ROUNDS=12
MAX_LOAN_DURATION_DAYS=30
MAX_REVIEWS_PER_BOOK=500
MAX_FAVORITES_PER_USER=500

CLIENT_DEVELOPMENT_DOMAIN=http://localhost:5173
CLIENT_PRODUCTION_DOMAIN=https://your-frontend-domain.example
# Optional comma-separated override. If omitted, the two domains above are allowed.
CLIENT_ALLOWED_ORIGINS=
TRUST_PROXY_HOPS=0

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
